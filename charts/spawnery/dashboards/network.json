          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (server) (sum by (namespace, server) (label_replace(container_memory_working_set_bytes{container!=\"\",image!=\"\"}, \"server\", \"$1\", \"pod\", \"(.*)\")) * on (namespace, server) group_left() max by (namespace, server) (spawnery_server_phase{network=\"$network\",group=~\"$group\"}))",
          "refId": "I",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (server) (sum by (namespace, server) (label_replace(rate(container_cpu_usage_seconds_total{container!=\"\",image!=\"\"}[5m]), \"server\", \"$1\", \"pod\", \"(.*)\")) * on (namespace, server) group_left() max by (namespace, server) (spawnery_server_phase{network=\"$network\",group=~\"$group\"}))",
          "refId": "J",
          "instant": true,
          "range": false,
          "format": "table"
        }
