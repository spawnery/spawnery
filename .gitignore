.superpowers/
bin/
cover.out
result
result-*
.direnv/
# The platform APIs are symlinked into their own subprojects before the build;
# see nix/agents.nix. The Gradle root is agent/, so .gradle/ and build/ now
# appear once at the root and once per subproject -- and Nix builds from the
# git index, so an ignore that missed one would stage build output into the
# tree the build reads.
agent/paper/paper-repo
agent/velocity/velocity.jar
agent/.gradle/
agent/build/
agent/**/.gradle/
agent/**/build/

# Vendored by hack/vendor-mermaid.sh from the pin in nix/mermaid.nix.
docs/assets/mermaid.min.js

# Vendored by hack/vendor-fonts.sh from the pins in nix/fonts.nix.
docs/assets/fonts/

# Vendored by hack/vendor-javadoc.sh from nix/agent-api-javadoc.nix.
docs/plugin-api/javadoc/

# mkdocs build output; mkdocs.yml sets no site_dir, so this is its default.
site/
